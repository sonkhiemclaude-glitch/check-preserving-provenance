# Credentials stay on the publisher machine, never in YAML, outputs or release documents.
# The existing Bedrock_API spelling is accepted; set only one API key field.
Bedrock_API=
# AWS_BEARER_TOKEN_BEDROCK=
# BEDROCK_API_KEY=

# Defaults are documented in docs/e5_bedrock.md. Override only if your account uses another route.
BEDROCK_API_MODE=bedrock-chat
AWS_REGION=us-east-1
BEDROCK_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
BEDROCK_MODEL_ID=openai.gpt-oss-120b

E5_TEMPERATURE=0
E5_REASONING_EFFORT=low
E5_MAX_OUTPUT_TOKENS=1024
E5_TIMEOUT_SECONDS=60
E5_MAX_RETRIES=2
E5_MAX_REQUESTS=80
E5_MAX_TOTAL_TOKENS=100000
